{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <title>{% block title %}Site des Plaisanciers{% endblock %}</title>

    {# CSS du thème #}
    <link href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('css/bootstrap-icons.css') }}" rel="stylesheet">
    <link href="{{ asset('css/templatemo-festava-live.css') }}" rel="stylesheet">

    {# Overrides / style custom #}
    <link href="{{ asset('css/custom.css') }}" rel="stylesheet">

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100;200;400;700&display=swap" rel="stylesheet">

    {% block stylesheets %}{% endblock %}

    <style>
        html { scroll-behavior: smooth; }
        :root { --navbar-h: 0px; }
    </style>

</head>

{# Défauts sûrs #}
{#{% set body_class = body_class|default('') %}#}
{#{% set navbar_is_transparent = navbar_is_transparent|default(false) %}#}

{#<body class="with-fixed-navbar {{ body_class }}">#}

{# Détecte la page login pour ajouter une classe spéciale #}
{% set body_class = body_class|default('') %}
{% set navbar_is_transparent = navbar_is_transparent|default(false) %}

<body class="with-fixed-navbar {{ body_class }} {% if app.request.attributes.get('_route') == 'app_login' %}login-page{% endif %}">


{# Popup d'annonce (voir AnnouncementPopupController) — ne s'affiche que s'il y a
   une annonce active, et une seule fois par visite selon sa fréquence configurée #}
{{ render(path('site_announcement_popup')) }}

{# Bandeau (météo / marées) — IMPORTANT: vía subrequest al contrôleur #}
<header id="siteHeader">
    {{ render(path('site_header')) }}
</header>

{# Navbar principale -> le partial doit avoir <nav id="mainNav" ...> #}
{% include 'partials/_navbar.html.twig' with { 'navbar_is_transparent': navbar_is_transparent } %}

<main id="main-content">
    {% block body %}{% endblock %}
</main>

{% include 'partials/_footer.html.twig' %}

{# JS principal (local) #}
<script src="{{ asset('js/jquery.min.js') }}"></script>
<script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
<script src="{{ asset('js/jquery.sticky.js') }}"></script>
<script src="{{ asset('js/click-scroll-safe.js') }}"></script>
<script src="{{ asset('js/custom.js') }}"></script>

{% block javascripts %}{% endblock %}

<script>
    // Ouverture au survol des menus déroulants de la navbar (ordinateur uniquement) ;
    // le clic (mobile et desktop) est déjà géré nativement par Bootstrap via
    // data-bs-toggle="dropdown", donc on ne le réimplémente pas ici pour éviter
    // tout désync entre notre logique et l'état interne de Bootstrap.
    document.addEventListener("DOMContentLoaded", function() {
        const isDesktop = () => window.innerWidth >= 992;

        document.querySelectorAll('.navbar .dropdown').forEach(function (dropdown) {
            const toggle = dropdown.querySelector('.dropdown-toggle');
            if (!toggle || typeof window.bootstrap === "undefined" || !window.bootstrap.Dropdown) return;

            dropdown.addEventListener('mouseenter', function () {
                if (!isDesktop()) return;
                window.bootstrap.Dropdown.getOrCreateInstance(toggle).show();
            });

            dropdown.addEventListener('mouseleave', function () {
                if (!isDesktop()) return;
                window.bootstrap.Dropdown.getOrCreateInstance(toggle).hide();
            });
        });
    });
</script>

</body>
</html>
