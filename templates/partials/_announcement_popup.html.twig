{# Popup d'annonce affiché à l'ouverture du site (voir AnnouncementPopupController) #}
<div class="modal fade announcement-modal" id="announcementPopupModal" tabindex="-1"
     aria-labelledby="announcementPopupLabel" aria-hidden="true"
     data-announcement-id="{{ announcement.id }}"
     data-frequency="{{ announcement.frequency.value }}">
    <div class="modal-dialog modal-dialog-centered announcement-modal-dialog">
        <div class="modal-content">
            <button type="button" class="btn-close announcement-modal-close" data-bs-dismiss="modal" aria-label="Fermer"></button>

            {% if announcement.title %}
                <h2 class="visually-hidden" id="announcementPopupLabel">{{ announcement.title }}</h2>
            {% endif %}

            {% set inner %}
                {% if announcement.imageFileName %}
                    <img src="{{ asset('uploads/announcements/' ~ announcement.imageFileName) }}"
                         alt="{{ announcement.title }}"
                         class="announcement-modal-img">
                {% endif %}

                {% if announcement.title or announcement.bodyText %}
                    <div class="announcement-modal-text">
                        {% if announcement.title %}<h3 class="announcement-modal-title">{{ announcement.title }}</h3>{% endif %}
                        {% if announcement.bodyText %}<p class="announcement-modal-body">{{ announcement.bodyText|nl2br }}</p>{% endif %}
                    </div>
                {% endif %}

                {% if announcement.linkUrl %}
                    <div class="announcement-modal-cta">
                        <a href="{{ announcement.linkUrl }}" class="btn custom-btn" target="_blank" rel="noopener">
                            {{ announcement.linkLabel ?: 'En savoir plus' }}
                        </a>
                    </div>
                {% endif %}
            {% endset %}

            {% if announcement.linkUrl and announcement.imageFileName and not announcement.title and not announcement.bodyText %}
                {# Image seule + lien : toute l'image devient cliquable, pas de bouton en double #}
                <a href="{{ announcement.linkUrl }}" target="_blank" rel="noopener" class="announcement-modal-img-link">
                    <img src="{{ asset('uploads/announcements/' ~ announcement.imageFileName) }}"
                         alt="{{ announcement.title }}"
                         class="announcement-modal-img">
                </a>
            {% else %}
                {{ inner }}
            {% endif %}
        </div>
    </div>
</div>

<script>
    (function () {
        var modalEl = document.getElementById('announcementPopupModal');
        if (!modalEl) {
            return;
        }

        var id = modalEl.getAttribute('data-announcement-id');
        var frequency = modalEl.getAttribute('data-frequency');
        var storageKey = 'upac_announcement_seen_' + id;

        function alreadySeen() {
            switch (frequency) {
                case 'ALWAYS':
                    return false;
                case 'ONCE_PER_SESSION':
                    return sessionStorage.getItem(storageKey) === '1';
                case 'ONCE_PER_DAY':
                    return localStorage.getItem(storageKey) === todayStamp();
                case 'ONCE_EVER':
                    return localStorage.getItem(storageKey) === '1';
                default:
                    return false;
            }
        }

        function markSeen() {
            if (frequency === 'ONCE_PER_SESSION') {
                sessionStorage.setItem(storageKey, '1');
            } else if (frequency === 'ONCE_PER_DAY') {
                localStorage.setItem(storageKey, todayStamp());
            } else if (frequency === 'ONCE_EVER') {
                localStorage.setItem(storageKey, '1');
            }
        }

        function todayStamp() {
            return new Date().toISOString().slice(0, 10);
        }

        if (alreadySeen()) {
            return;
        }

        function openPopup() {
            if (typeof bootstrap === 'undefined') {
                return; // bootstrap.bundle.min.js n'a toujours pas chargé, on abandonne proprement
            }
            var modal = new bootstrap.Modal(modalEl);
            modal.show();
            markSeen();
        }

        // 'load' (pas 'DOMContentLoaded') : ce script est inclus tôt dans la page,
        // bien avant bootstrap.bundle.min.js chargé en bas de page. Attendre 'load'
        // garantit que bootstrap est disponible, quel que soit l'ordre des scripts.
        window.addEventListener('load', openPopup);
    })();
</script>
