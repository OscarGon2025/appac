{# usa le layout de EasyAdmin #}
{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
    <div class="dashboard container-fluid py-3">

        {#Notification avec message flash pour confirmer qu'un utilisateur a bien été apprové par l'admin#}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mt-2">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="mb-1">Tableau de bord</h1>
                <p class="text-muted mb-0">Vue d’ensemble de l’activité du site UPAC.</p>
            </div>
        </div>

        {# ======================================================
           Cartes-clés (KPI)
           ====================================================== #}
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-2">
                <div class="dash-kpi">
                    <div class="dash-kpi-icon is-primary"><i class="fa fa-users"></i></div>
                    <div class="dash-kpi-value">{{ stats.users.total }}</div>
                    <div class="dash-kpi-label">Utilisateurs</div>
                    <div class="dash-kpi-sub">{{ stats.users.pending }} en attente d’approbation</div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="dash-kpi">
                    <div class="dash-kpi-icon is-success"><i class="fa fa-newspaper"></i></div>
                    <div class="dash-kpi-value">{{ stats.content.articles }}</div>
                    <div class="dash-kpi-label">Articles</div>
                    <div class="dash-kpi-sub">{{ stats.content.articlesPublished }} publiés</div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="dash-kpi">
                    <div class="dash-kpi-icon is-info"><i class="fa fa-calendar"></i></div>
                    <div class="dash-kpi-value">{{ stats.content.events }}</div>
                    <div class="dash-kpi-label">Événements</div>
                    <div class="dash-kpi-sub">{{ stats.content.eventsUpcoming }} à venir</div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="dash-kpi">
                    <div class="dash-kpi-icon is-warning"><i class="fa fa-image"></i></div>
                    <div class="dash-kpi-value">{{ stats.media.photos + stats.media.archiveImages }}</div>
                    <div class="dash-kpi-label">Photos</div>
                    <div class="dash-kpi-sub">{{ stats.media.albums }} albums &middot; {{ stats.media.archiveImages }} pour articles</div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="dash-kpi">
                    <div class="dash-kpi-icon is-danger"><i class="fa fa-bullhorn"></i></div>
                    <div class="dash-kpi-value">{{ stats.classifieds.total }}</div>
                    <div class="dash-kpi-label">Annonces</div>
                    <div class="dash-kpi-sub">{{ stats.classifieds.byStatus.PENDING }} en attente</div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="dash-kpi">
                    <div class="dash-kpi-icon is-secondary"><i class="fa fa-eye"></i></div>
                    <div class="dash-kpi-value">{{ stats.visits.total }}</div>
                    <div class="dash-kpi-label">Visites (total)</div>
                    <div class="dash-kpi-sub">{{ stats.visits.last14Days }} sur 14 jours</div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            {# ======================================================
               Graphique : visites des 14 derniers jours
               ====================================================== #}
            <div class="col-lg-8">
                <div class="dash-card h-100">
                    <h2 class="dash-card-title">Visites — 14 derniers jours</h2>
                    {% if stats.visits.last14Days > 0 %}
                        <svg viewBox="0 0 700 200" class="dash-chart" role="img"
                             aria-label="Nombre de visites par jour sur les 14 derniers jours">
                            {% set barWidth = 34 %}
                            {% set gap = 14 %}
                            {% set chartHeight = 140 %}
                            {% set baseline = 160 %}
                            {% for date, count in stats.visits.daily %}
                                {% set x = loop.index0 * (barWidth + gap) + 10 %}
                                {% set h = stats.visits.max > 0 ? (count / stats.visits.max * chartHeight) : 0 %}
                                <text x="{{ x + barWidth / 2 }}" y="{{ baseline - h - 8 }}"
                                      class="dash-chart-value" text-anchor="middle">{{ count > 0 ? count : '' }}</text>
                                <rect x="{{ x }}" y="{{ baseline - h }}" width="{{ barWidth }}" height="{{ h }}"
                                      rx="4" class="dash-chart-bar"></rect>
                                <text x="{{ x + barWidth / 2 }}" y="{{ baseline + 18 }}"
                                      class="dash-chart-label" text-anchor="middle">{{ date|date('d/m') }}</text>
                            {% endfor %}
                        </svg>
                    {% else %}
                        <p class="text-muted mb-0">Pas encore de visite enregistrée.</p>
                    {% endif %}
                </div>
            </div>

            {# ======================================================
               Répartition des annonces par statut
               ====================================================== #}
            <div class="col-lg-4">
                <div class="dash-card h-100">
                    <h2 class="dash-card-title">Annonces par statut</h2>
                    {% if stats.classifieds.total > 0 %}
                        {% for statusValue, count in stats.classifieds.byStatus %}
                            {% set status = constant('App\\Enum\\AdStatus::' ~ statusValue) %}
                            {% set pct = (count / stats.classifieds.total * 100)|round %}
                            <div class="dash-bar-row">
                                <div class="dash-bar-row-label">
                                    <span class="badge text-bg-{{ status.badge }}">{{ status.label }}</span>
                                    <span class="text-muted">{{ count }}</span>
                                </div>
                                <div class="dash-bar-track">
                                    <div class="dash-bar-fill is-{{ status.badge }}" style="width: {{ pct }}%"></div>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <p class="text-muted mb-0">Aucune annonce pour le moment.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            {# ======================================================
               Dernières annonces créées
               ====================================================== #}
            <div class="col-lg-7">
                <div class="dash-card h-100">
                    <h2 class="dash-card-title">Dernières annonces créées</h2>
                    {% if stats.classifieds.recent is not empty %}
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                <tr>
                                    <th>Titre</th>
                                    <th>Statut</th>
                                    <th>Créée le</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for ad in stats.classifieds.recent %}
                                    <tr>
                                        <td>
                                            <a href="{{ ea_url().setController('App\\Controller\\Admin\\ClassifiedAdCrudController').setAction('detail').setEntityId(ad.id) }}">
                                                {{ ad.title }}
                                            </a>
                                        </td>
                                        <td><span class="badge text-bg-{{ ad.status.badge }}">{{ ad.status.label }}</span></td>
                                        <td class="text-muted">{{ ad.createdAt|date('d/m/Y') }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted mb-0">Aucune annonce pour le moment.</p>
                    {% endif %}
                </div>
            </div>

            {# ======================================================
               Adhésions par statut
               ====================================================== #}
            <div class="col-lg-5">
                <div class="dash-card h-100">
                    <h2 class="dash-card-title">Adhésions par statut</h2>
                    {% if stats.memberships.total > 0 %}
                        {% for statusValue, count in stats.memberships.byStatus %}
                            {% set status = constant('App\\Enum\\MembershipStatus::' ~ statusValue) %}
                            {% set pct = (count / stats.memberships.total * 100)|round %}
                            <div class="dash-bar-row">
                                <div class="dash-bar-row-label">
                                    <span class="badge text-bg-{{ status.badge }}">{{ status.label }}</span>
                                    <span class="text-muted">{{ count }}</span>
                                </div>
                                <div class="dash-bar-track">
                                    <div class="dash-bar-fill is-{{ status.badge }}" style="width: {{ pct }}%"></div>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <p class="text-muted mb-0">Aucune adhésion pour le moment.</p>
                    {% endif %}
                    <hr>
                    <p class="mb-0">
                        <i class="fa fa-user-plus text-muted me-1"></i>
                        <strong>{{ stats.memberships.pendingApplications }}</strong> demande(s) d’adhésion en attente
                    </p>
                    <p class="mb-0">
                        <i class="fa fa-ship text-muted me-1"></i>
                        <strong>{{ stats.outings.pending }}</strong> / {{ stats.outings.total }} demande(s) de sortie en attente
                    </p>
                </div>
            </div>
        </div>

        {# ======================================================
           Accès rapides
           ====================================================== #}
        <div class="dash-card">
            <h2 class="dash-card-title">Accès rapides</h2>
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <a class="btn btn-outline-secondary w-100" href="{{ ea_url().setController('App\\Controller\\Admin\\ArticleCrudController').setAction('index') }}">
                        <i class="fa fa-newspaper me-1"></i> Articles
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a class="btn btn-outline-secondary w-100" href="{{ ea_url().setController('App\\Controller\\Admin\\EventCrudController').setAction('index') }}">
                        <i class="fa fa-calendar me-1"></i> Événements
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a class="btn btn-outline-secondary w-100" href="{{ ea_url().setController('App\\Controller\\Admin\\ClassifiedAdCrudController').setAction('index') }}">
                        <i class="fa fa-bullhorn me-1"></i> Annonces
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a class="btn btn-outline-secondary w-100" href="{{ ea_url().setController('App\\Controller\\Admin\\MembershipApplicationCrudController').setAction('index') }}">
                        <i class="fa fa-user-plus me-1"></i> Demandes d’adhésion
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
